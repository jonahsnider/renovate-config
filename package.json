{
	"name": "@jonahsnider/renovate-config",
	"version": "0.0.0-development",
	"private": true,
	"bugs": {
		"url": "https://github.com/jonahsnider/renovate-config/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/renovate-config.git"
	},
	"scripts": {
		"check:duplicate-groups": "node scripts/check-duplicate-groups.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"style": "oxfmt --check",
		"style:fix": "oxfmt --write",
		"test:enqueue": "node --test scripts/enqueue-renovate.test.mjs",
		"validate": "renovate-config-validator"
	},
	"devDependencies": {
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"renovate": "44.61.6",
		"semantic-release": "25.0.9"
	},
	"dependenciesMeta": {
		"re2": {
			"built": true
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.3.1"
}
