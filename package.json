{
	"name": "@jonahsnider/renovate-config",
	"version": "0.0.0-development",
	"private": true,
	"bugs": {
		"url": "https://github.com/jonahsnider/renovate-config/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/renovate-config.git"
	},
	"scripts": {
		"check:duplicate-groups": "node scripts/check-duplicate-groups.mjs",
		"check:codemods": "tsc --project codemods/crypto-random-string-v6/tsconfig.json && codemod workflow validate --workflow codemods/crypto-random-string-v6 && codemod jssg test codemods/crypto-random-string-v6/scripts/codemod.ts --language tsx codemods/crypto-random-string-v6/tests --sequential --strictness ast",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"style": "oxfmt --check",
		"style:fix": "oxfmt --write",
		"test:enqueue": "node --test scripts/enqueue-renovate.test.mjs",
		"validate": "renovate-config-validator --no-global default.json renovate.json && renovate-config-validator renovate.config.cjs"
	},
	"devDependencies": {
		"@codemod.com/jssg-types": "1.6.3",
		"codemod": "1.17.3",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"renovate": "44.69.10",
		"semantic-release": "25.0.9",
		"typescript": "7.0.2"
	},
	"dependenciesMeta": {
		"re2": {
			"built": true
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.3.4"
}
