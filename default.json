{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":label(dependencies)",
		":semanticCommitTypeAll(build)",
		":disableRateLimiting",
		":automergeMinor",
		":automergeBranch",
		":prNotPending"
	],
	"gitIgnoredAuthors": [
		"114827586+autofix-ci[bot]@users.noreply.github.com",
		"29139614+renovate[bot]@users.noreply.github.com",
		"287348350+jonahsnider[bot]@users.noreply.github.com"
	],
	"packageRules": [
		{
			"groupName": "typescript",
			"matchPackageNames": ["typescript", "@tsconfig/**"]
		},
		{
			"matchPackageNames": ["typescript"],
			"matchCurrentVersion": "6",
			"matchNewValue": "/^[^0-9]*7(?:\\.|$)/",
			"automerge": true
		},
		{
			"matchPackageNames": ["@typescript/native-preview"],
			"replacementName": "typescript",
			"replacementVersion": "7.0.0"
		},
		{
			"groupName": "xo",
			"matchPackageNames": ["xo", "eslint-config-xo", "prettier-config-xo", "@jonahsnider/xo-config", "eslint-config-xo-{space,react,typescript,flow}"]
		},
		{
			"groupName": "rollup",
			"matchPackageNames": ["rollup", "@rollup/**", "rollup-plugin-*"]
		},
		{
			"groupName": "drizzle",
			"matchPackageNames": ["drizzle-*"]
		},
		{
			"groupName": "convex",
			"matchPackageNames": ["convex", "convex-*", "@convex-dev/**"]
		},
		{
			"groupName": "error-prone",
			"matchSourceUrls": ["https://github.com/google/error-prone", "https://github.com/PicnicSupermarket/error-prone-support"]
		},
		{
			"groupName": "slack",
			"matchSourceUrls": ["https://github.com/slackapi/**"]
		},
		{
			"groupName": "chat-sdk",
			"matchSourceUrls": ["https://github.com/vercel/chat"]
		},
		{
			"groupName": "fallow",
			"matchSourceUrls": ["https://github.com/fallow-rs/fallow"]
		},
		{
			"groupName": "simplewebauthn",
			"matchSourceUrls": ["https://github.com/MasterKale/SimpleWebAuthn"]
		},
		{
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["actions/checkout", "actions/cache", "actions/setup-*"],
			"matchUpdateTypes": ["major"],
			"automerge": true
		},
		{
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["endevco/aube-action"],
			"replacementName": "jdx/aube-action",
			"automerge": true
		},
		{
			"description": "Migrate the frozen setup-vp v1 tag to its exact version",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["voidzero-dev/setup-vp"],
			"matchCurrentValue": "/^v1$/",
			"replacementVersion": "v1.15.0",
			"versioning": "semver"
		},
		{
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "24 hours"
		},
		{
			"description": "Migrate crypto-random-string v5 to its synchronous v6 API",
			"matchDatasources": ["npm"],
			"matchPackageNames": ["crypto-random-string"],
			"matchCurrentVersion": "/^5\\./",
			"matchNewValue": "/^6\\./",
			"constraintsFiltering": "strict",
			"postUpgradeTasks": {
				"commands": [
					"codemod workflow run --workflow /usr/src/app/codemods/crypto-random-string-v6 --target . --allow-dirty --no-interactive --disable-analytics"
				],
				"executionMode": "update"
			}
		},
		{
			"matchDatasources": ["npm"],
			"matchPackageNames": ["vercel"],
			"matchUpdateTypes": ["major"],
			"automerge": true
		}
	],
	"timezone": "America/Los_Angeles"
}
